# Copy to .env (never commit .env). Put your Gemini key here, not in chat or source files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM backend: auto | gemini | ollama | none   (auto = gemini if a key is set, else none)
PHARMAGENE_LLM=auto
# Fully local / on-prem generation (paper Sec. VII):
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embeddings: auto | sbert | gemini | hashing   (auto = sbert if installed, else gemini if key, else hashing)
PHARMAGENE_EMBEDDINGS=auto
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_BACKEND=numpy

# Retrieval / abstention
HYBRID_ALPHA=0.5
TOP_K=5
CANDIDATE_K=20
CONFIDENCE_TAU=0.5

# Audit log (JSONL). Raw genotype/query text is NOT logged unless this is true.
AUDIT_LOG=results/audit.jsonl
AUDIT_LOG_RAW=false

# Optional API auth for `pharmagene serve` (comma-separated keys). Empty = open (local dev only).
PHARMAGENE_API_KEYS=
